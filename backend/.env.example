JWT_EXPIRES_IN=1h
CORS_ORIGIN=http://localhost:3000
EMAIL_DOMAIN=hub.ai
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
PORT=3001
NODE_ENV=development
