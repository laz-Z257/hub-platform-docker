# ⚠️  REQUERIDAS — Copiar a .env y CAMBIAR antes de desplegar
#
# Generar secrets:
#   openssl rand -base64 24   (POSTGRES_PASSWORD)
#   openssl rand -hex 32      (JWT_SECRET, JWT_REFRESH_SECRET)
#   openssl rand -hex 16      (SEED_ADMIN_PASSWORD)

POSTGRES_USER=hub_admin
POSTGRES_PASSWORD=CAMBIAR
DATABASE_URL=postgres://hub_admin:CAMBIAR@postgres:5432/hub_platform
JWT_SECRET=CAMBIAR
JWT_REFRESH_SECRET=CAMBIAR
SEED_ADMIN_PASSWORD=CAMBIAR
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# URL del sistema externo (solo backend, nunca expuesta al frontend)
EXTERNAL_SYSTEMS_URL=http://localhost:8100/Seguridad-WEB/XHTML/general/login.xhtml
MAX_LOGIN_ATTEMPTS=5
